# 高级可选覆盖。日常使用直接运行 npm start，不需要创建 .env。
# npm start 不会自动加载本文件；如需启用，执行：
# node --env-file=.env server.mjs

# 本地监听与运行限制。HOST 只能是 127.0.0.1、localhost 或 ::1。
HOST=127.0.0.1
PORT=3000
LLM_TIMEOUT_MS=45000
MAX_SOURCE_CHARS=12000

# 本机加密配置位置。默认会自动创建 data/config.key。
DATA_DIR=./data
# AI_CONFIG_FILE=./data/ai-config.enc.json
# CONFIG_ENCRYPTION_KEY_FILE=./data/config.key

# 可选：自行托管 32 字节加密主密钥（Base64 或 64 位十六进制）。
# 默认本地模式留空时会自动生成 data/config.key。
# 如果人为设置 NODE_ENV=production，本项必须显式提供，否则服务启动失败。
# CONFIG_ENCRYPTION_KEY=

# 可选：MODEL_PROVIDER_ALLOWED_HOSTS 仅在 NODE_ENV=production 时生效，逗号分隔。
# MODEL_PROVIDER_ALLOWED_HOSTS=api.example.com,gateway.example.net
