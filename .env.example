# 运行时安全配置。生产环境必须填写前三项；不要提交真实值。
ADMIN_PASSWORD_HASH=
CONFIG_ENCRYPTION_KEY=
PUBLIC_ORIGIN=http://127.0.0.1:3000
TRUST_PROXY=false

# 仅自定义供应商需要追加允许访问的 HTTPS 主机，多个主机用逗号分隔。
MODEL_PROVIDER_ALLOWED_HOSTS=

# 模型供应商、模型与 API Key 登录后在网页中配置，并加密保存到 DATA_DIR。
DATA_DIR=./data
LLM_TIMEOUT_MS=45000
MAX_SOURCE_CHARS=12000
HOST=127.0.0.1
PORT=3000
PUBLISHED_PORT=3000
